generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum VenueStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  ACTIVE
  INACTIVE
}

enum SessionMode {
  TWO_PERSON
  GROUP
}

enum SessionStatus {
  WAITING
  READY
  ACTIVE
  ENDING
  ENDED
}

enum ParticipantStatus {
  WAITING
  ACTIVE
  COMPLETED
}

enum ConnectionType {
  FRIENDS_ONLY
  FRIENDS
  MAYBE_MORE
  ALREADY_TOGETHER
}

enum SpillType {
  QUESTION
  INSTRUCTION
  CHALLENGE
  OBSERVATION
  SCENARIO
  VISION
}

enum ConnectionStatus {
  MUTUAL
  NONE
}


// Phase 2 "Meet someone new"
enum OpenPresenceStatus {
  OPEN // listed as available
  PAUSED // still open, but hidden from the list for now
  MATCHED // accepted an invite, playing / meeting
  CLOSED // turned off, started a table game, or expired
}

enum SpillReportReason {
  UNCOMFORTABLE
  INAPPROPRIATE_NAME
  SPAM
  OTHER
}

enum SpillReportStatus {
  OPEN
  RESOLVED
}

enum SpillInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────

model Venue {
  id        String      @id @default(cuid())
  name      String
  city      String
  status    VenueStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tables        Table[]
  notifications SpillNotification[]

  @@map("venues")
}

model Table {
  id          String      @id @default(cuid())
  venueId     String      @map("venue_id")
  tableCode   String      @map("table_code")
  displayName String      @map("display_name")
  status      TableStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  venue         Venue     @relation(fields: [venueId], references: [id])
  sessions      Session[]
  openPresences OpenPresence[]
  

  @@unique([venueId, tableCode])
  @@map("tables")
}

model Session {
  id          String        @id @default(cuid())
  tableId     String        @map("table_id")
  sessionCode String        @unique @map("session_code")
  mode        SessionMode   @default(TWO_PERSON)
  groupSize   Int?          @map("group_size")
  status      SessionStatus @default(WAITING)
  startedAt   DateTime?     @map("started_at")
  endedAt     DateTime?     @map("ended_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  table                Table                @relation(fields: [tableId], references: [id])
  participants         Participant[]
  connectionSelections ConnectionSelection[]
  sessionSpills        SessionSpill[]
  connections          Connection[]
  openPresences        OpenPresence[]
  spillInvites         SpillInvite[]

  @@map("sessions")
}

model Participant {
  id               String            @id @default(cuid())
  sessionId        String            @map("session_id")
  displayName      String            @map("display_name")
  participantToken String            @unique @map("participant_token")
  joinedAt         DateTime          @default(now()) @map("joined_at")
  leftAt           DateTime?         @map("left_at")
  status           ParticipantStatus @default(WAITING)
  wantsStayConnected Boolean?        @map("wants_stay_connected")
  // Phase 3: set when this player signs in to Stay Connected.
  guestId            String?           @map("guest_id")

  session              Session               @relation(fields: [sessionId], references: [id])
  guest                Guest?                @relation(fields: [guestId], references: [id], onDelete: SetNull)
  connectionSelections ConnectionSelection[]
  openPresences        OpenPresence[]
  loginTokens          LoginToken[]

  @@map("participants")
}

model ConnectionSelection {
  id             String         @id @default(cuid())
  sessionId      String         @map("session_id")
  participantId  String         @map("participant_id")
  connectionType ConnectionType @map("connection_type")
  createdAt      DateTime       @default(now()) @map("created_at")

  session     Session     @relation(fields: [sessionId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([sessionId, participantId])
  @@map("connection_selections")
}

model Spill {
  id            String           @id @default(cuid())
  type          SpillType
  content       String
  category      String?
  difficulty    Int?
  active        Boolean          @default(true)
  // Rỗng = phù hợp với MỌI connection type. Có giá trị = chỉ hiện cho các type liệt kê.
  eligibleTypes ConnectionType[] @default([]) @map("eligible_types")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  sessionSpills SessionSpill[]

  @@map("spills")
}


model SessionSpill {
  id          String    @id @default(cuid())
  sessionId   String    @map("session_id")
  spillId     String    @map("spill_id")
  sequence    Int
  presentedAt DateTime? @map("presented_at")
  completedAt DateTime? @map("completed_at")
  // true = the spotlight player used a pass on this card (forfeit shown to everyone)
  passed      Boolean   @default(false)

  session Session @relation(fields: [sessionId], references: [id])
  spill   Spill   @relation(fields: [spillId], references: [id])

  @@unique([sessionId, sequence])
  @@map("session_spills")
}

model Connection {
  id             String           @id @default(cuid())
  sessionId      String           @map("session_id")
  participantAId String           @map("participant_a_id")
  participantBId String           @map("participant_b_id")
  status         ConnectionStatus @default(NONE)
  createdAt      DateTime         @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id])

  @@map("connections")
}


// ─────────────────────────────────────────
// PHASE 2 · MEET SOMEONE NEW
// ─────────────────────────────────────────

model OpenPresence {
  id             String             @id @default(cuid())
  tableId        String             @map("table_id")
  displayName    String             @map("display_name")
  presenceToken  String             @unique @map("presence_token")
  status         OpenPresenceStatus @default(OPEN)
  ageConfirmedAt DateTime           @map("age_confirmed_at")
  expiresAt      DateTime           @map("expires_at")
  // Set once matched: the 2-person session and this phone's player in it.
  sessionId      String?            @map("session_id")
  participantId  String?            @map("participant_id")
  // Phase 3: a signed-in guest who turned on Open (lets us tell connections).
  guestId        String?            @map("guest_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  guest       Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  table       Table         @relation(fields: [tableId], references: [id])
  session     Session?      @relation(fields: [sessionId], references: [id])
  participant Participant?  @relation(fields: [participantId], references: [id])
  invitesSent SpillInvite[] @relation("InviteFrom")
  invitesGot  SpillInvite[] @relation("InviteTo")
  reportsMade SpillReport[] @relation("ReportBy")
  reportsGot  SpillReport[] @relation("ReportAbout")

  @@index([status, expiresAt])
  @@map("open_presences")
}

model SpillInvite {
  id          String            @id @default(cuid())
  fromId      String            @map("from_id")
  toId        String            @map("to_id")
  status      SpillInviteStatus @default(PENDING)
  expiresAt   DateTime          @map("expires_at")
  respondedAt DateTime?         @map("responded_at")
  // Filled on accept: where to meet and how to recognise each other.
  sessionId   String?           @map("session_id")
  meetColor   String?           @map("meet_color")
  meetCode    String?           @map("meet_code")
  createdAt   DateTime          @default(now()) @map("created_at")

  from    OpenPresence @relation("InviteFrom", fields: [fromId], references: [id])
  to      OpenPresence @relation("InviteTo", fields: [toId], references: [id])
  session Session?     @relation(fields: [sessionId], references: [id])

  @@index([toId, status])
  @@index([fromId, status])
  @@map("spill_invites")
}

// "Report" from Meet someone new. Staff see these in /admin.
model SpillReport {
  id         String            @id @default(cuid())
  reporterId String            @map("reporter_id")
  reportedId String            @map("reported_id")
  reason     SpillReportReason
  note       String?
  status     SpillReportStatus @default(OPEN)
  createdAt  DateTime          @default(now()) @map("created_at")
  resolvedAt DateTime?         @map("resolved_at")

  reporter OpenPresence @relation("ReportBy", fields: [reporterId], references: [id])
  reported OpenPresence @relation("ReportAbout", fields: [reportedId], references: [id])

  @@index([status, createdAt])
  @@index([reportedId])
  @@map("spill_reports")
}

// ─────────────────────────────────────────
// PHASE 3 · STAY CONNECTED
// ─────────────────────────────────────────

// A guest who signed in with an email magic link (no password).
// Only ever offered after a mutual Stay Connected.
model Guest {
  id                  String   @id @default(cuid())
  email               String   @unique
  // Name from the last game they played — shown to their connections.
  displayName         String?  @map("display_name")
  emailNotifications  Boolean  @default(true) @map("email_notifications")
  notificationsPaused Boolean  @default(false) @map("notifications_paused")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  participants       Participant[]
  openPresences      OpenPresence[]
  connectionsA       SpillConnection[]   @relation("ConnectionA")
  connectionsB       SpillConnection[]   @relation("ConnectionB")
  notificationsGot   SpillNotification[] @relation("NotificationTo")
  notificationsAbout SpillNotification[] @relation("NotificationAbout")

  @@map("guests")
}

// One-time sign-in link. Only the SHA-256 of the token is stored.
model LoginToken {
  id            String    @id @default(cuid())
  email         String
  tokenHash     String    @unique @map("token_hash")
  // The player who asked from the result screen — linked on sign-in.
  participantId String?   @map("participant_id")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@map("login_tokens")
}

// Two guests who both chose Stay Connected. guestAId < guestBId (sorted).
model SpillConnection {
  id        String   @id @default(cuid())
  guestAId  String   @map("guest_a_id")
  guestBId  String   @map("guest_b_id")
  // Names as they knew each other in the game.
  nameA     String   @map("name_a")
  nameB     String   @map("name_b")
  sessionId String?  @map("session_id")
  // "Don't tell me when they're back" — each side decides for themselves.
  mutedByA  Boolean  @default(false) @map("muted_by_a")
  mutedByB  Boolean  @default(false) @map("muted_by_b")
  createdAt DateTime @default(now()) @map("created_at")

  guestA Guest @relation("ConnectionA", fields: [guestAId], references: [id], onDelete: Cascade)
  guestB Guest @relation("ConnectionB", fields: [guestBId], references: [id], onDelete: Cascade)

  @@unique([guestAId, guestBId])
  @@map("spill_connections")
}

// "Linh is at SPILL Saigon now and open to SPILL."
model SpillNotification {
  id           String    @id @default(cuid())
  toGuestId    String    @map("to_guest_id")
  aboutGuestId String    @map("about_guest_id")
  aboutName    String    @map("about_name")
  venueId      String?   @map("venue_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  seenAt       DateTime? @map("seen_at")
  emailedAt    DateTime? @map("emailed_at")

  to    Guest  @relation("NotificationTo", fields: [toGuestId], references: [id], onDelete: Cascade)
  about Guest  @relation("NotificationAbout", fields: [aboutGuestId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([toGuestId, createdAt])
  @@index([aboutGuestId, toGuestId, createdAt])
  @@map("spill_notifications")
}

// ─────────────────────────────────────────
// WEBSITE · WAITLIST / COMMUNITY SIGN-UP
// ─────────────────────────────────────────

// Someone who asked for launch news from the website (before and after opening).
// One row per email per location; signing up again updates the row.
model WaitlistSignup {
  id           String   @id @default(cuid())
  email        String
  name         String?
  whatsapp     String?
  // "saigon", "tokyo"… — the SPILL they want to hear about.
  locationSlug String   @map("location_slug")
  // e.g. ["Opening news", "Events", "SPILL 42"]
  interests    String[] @default([])
  // Where on the site they signed up ("saigon-hero", "saigon-footer"…).
  source       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([email, locationSlug])
  @@index([locationSlug, createdAt])
  @@map("waitlist_signups")
}

// ─────────────────────────────────────────
// WEBSITE · WHAT'S ON (events + livestreams)
// ─────────────────────────────────────────

enum EventCategory {
  SPILL42
  MUSIC
  LIVE
  FOOD_DRINK
  COMMUNITY
  SPECIAL
}

// One thing happening at a SPILL location. Livestreams are events too
// (category LIVE), so the team keeps a single calendar.
model Event {
  id           String        @id @default(cuid())
  // "saigon", "tokyo"… — matches the website's location slug.
  locationSlug String        @map("location_slug")
  // URL part: /saigon/whats-on/<slug>. Unique per location.
  slug         String
  title        String
  // One or two lines for cards and link previews.
  summary      String
  description  String        @default("")
  category     EventCategory
  startsAt     DateTime      @map("starts_at")
  endsAt       DateTime?     @map("ends_at")
  // /assets/... or https://… — falls back to a category image.
  imageUrl     String?       @map("image_url")
  // External ticket / booking page, if any.
  ticketUrl    String?       @map("ticket_url")
  // YouTube watch/live link — shown as a player on the event page.
  youtubeUrl   String?       @map("youtube_url")
  rsvpEnabled  Boolean       @default(true) @map("rsvp_enabled")
  // Shown on the global homepage / global What's On.
  featured     Boolean       @default(false)
  // Drafts stay hidden from the website.
  published    Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  rsvps EventRsvp[]

  @@unique([locationSlug, slug])
  @@index([locationSlug, published, startsAt])
  @@map("events")
}

// "I'm coming" on an event page. The guest is also added to the waitlist.
model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  email     String
  name      String
  whatsapp  String?
  // Including the person signing up.
  partySize Int      @default(1) @map("party_size")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@map("event_rsvps")
}

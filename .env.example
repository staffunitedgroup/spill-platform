# Copy to .env.local and fill in. Never commit real values.

# Website lock screen (until SPILL opens to guests)
SITE_ACCESS_PASSWORD=""
SITE_ACCESS_SECRET=""
# Launch day: "true" opens only the SPILL 42 game (/spill-42, /spill/…) to everyone,
# while the rest of the site stays behind the lock screen.
SPILL42_PUBLIC=""

INVESTOR_OVERVIEW_PASSWORD=""
INVESTOR_SESSION_SECRET=""

# Email (Resend) — contact form + SPILL 42 sign-in links and "they're back" emails
RESEND_API_KEY=""
INQUIRY_FROM_EMAIL="SPILL Website <website@spillcafebar.com>"
# Optional: sender for SPILL 42 emails (defaults to INQUIRY_FROM_EMAIL)
SPILL_FROM_EMAIL=""

# SPILL 42 Stay Connected: signs the guest sign-in cookie. REQUIRED in production.
# Generate with: openssl rand -hex 32
SPILL_AUTH_SECRET=""
# Optional: public URL used in email links (defaults to the request's domain)
NEXT_PUBLIC_SITE_URL=""

NEXT_PUBLIC_CONTACT_PHONE=""

# Database (Neon). Pooled for the app, direct (unpooled) for migrations.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Admin pages (/admin/waitlist, /admin/events)
ADMIN_PASSWORD=""

# SPILL Live: YouTube channel for the latest videos (optional, found from the @handle if empty)
YOUTUBE_CHANNEL_ID=""
